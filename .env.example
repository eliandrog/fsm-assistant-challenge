# Copy to .env (git-ignored) and adjust. Never commit real values.
# Read by src/fsm_assistant/config.py: simple KEY=VALUE lines only (no `export`, no inline
# comments). Real environment variables take precedence, and an empty value means "use the
# default". No API key is needed: the model runs locally in Ollama (docs/DECISIONS.md, D-05).

# Address of the local Ollama server. Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Ollama model tag. No default yet; candidates: qwen3:14b, qwen3:30b-a3b.
# Nothing calls a model yet; it will be required only when one is used.
OLLAMA_MODEL=

# Path to the SQLite database. Default: data/data.db. A relative path is resolved
# against the project root, not the current directory.
FSM_DB_PATH=

# Maximum number of rows a query returns. Default: 1000
FSM_ROW_CAP=

# Seconds after which a running query is interrupted. Default: 15
FSM_QUERY_TIMEOUT_SECONDS=

# Largest result a query may return, in bytes of its values. Default: 5000000
FSM_MAX_RESULT_BYTES=
