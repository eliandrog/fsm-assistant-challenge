# Copy to .env (git-ignored) and adjust. Never commit real values.
# Read by src/fsm_assistant/config.py: simple KEY=VALUE lines only (no `export`, no inline
# comments). Real environment variables take precedence, and an empty value means "use the
# default". Tests and replayed model replies need nothing set.

# Anthropic API key. Needed only for a live model call, which costs money
# (docs/DECISIONS.md, D-14, D-20). Never commit, print or log it.
ANTHROPIC_API_KEY=

# Claude model id. Default: claude-haiku-5-5
ANTHROPIC_MODEL=

# How much reasoning the model spends: low, medium, high, xhigh or max. Default: medium
FSM_EFFORT=

# Most tokens the model may write in one reply. Default: 8000
FSM_MAX_TOKENS=

# Seconds to wait for one model reply. Default: 120
FSM_MODEL_TIMEOUT_SECONDS=

# Longest message accepted from the user, in characters. Default: 2000
FSM_MAX_MESSAGE_CHARACTERS=

# How the model states its action: tools or structured. Default: tools
FSM_TOOL_MODE=

# Path to the SQLite database. Default: data/data.db. A relative path is resolved
# against the project root, not the current directory.
FSM_DB_PATH=

# Maximum number of rows a query returns. Default: 1000
FSM_ROW_CAP=

# Seconds after which a running query is interrupted. Default: 15
FSM_QUERY_TIMEOUT_SECONDS=

# Largest result a query may return, in bytes of its values. Default: 5000000
FSM_MAX_RESULT_BYTES=

# Level of the application log: DEBUG, INFO, WARNING or ERROR. Default: INFO
FSM_LOG_LEVEL=

# Directory of the log file (app.log, rotated). Default: logs. A relative path is
# resolved against the project root.
FSM_LOG_DIR=

# Write the log file: on or off. Default: on
FSM_LOG_FILE=

# Hosted tracing with LangSmith (docs/DECISIONS.md, D-27). Off unless LANGSMITH_TRACING
# is true AND LANGSMITH_API_KEY is set. When on, each turn's question, SQL, tool call,
# codes, counts and timings are sent to LangSmith; result rows never are.
LANGSMITH_TRACING=

# LangSmith API key. Never commit, print or log it.
LANGSMITH_API_KEY=

# LangSmith API address. Default: https://api.smith.langchain.com
LANGSMITH_ENDPOINT=

# Where traces go: an agent and one of its environments (local, development, staging
# or production), both set together...
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=

# ...or a project, not both. With neither, the project fsm-assistant is used.
LANGSMITH_PROJECT=

# What a trace carries of the system prompt: hash (its version and SHA-256) or full
# (its text, which includes the schema context). Default: hash
FSM_TRACE_SYSTEM_PROMPT=

# The rule finder (docs/DECISIONS.md, D-35). Path of the rule bank: a second, writable
# SQLite file, created on first use; it must not be the transaction database.
# Default: var/rule_bank.db. A relative path is resolved against the project root.
FSM_RULE_BANK_PATH=

# Scenarios `find-rules` proposes and processes in one go, at most 25: at most
# 1 + 2 x this many model requests. The web page does not use it. Default: 1
FSM_FINDER_BATCH_SIZE=
